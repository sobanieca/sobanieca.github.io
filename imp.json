{
  "map": "src/app-map.js",
  // ANALYTICS sends the records of imp/analytics to imp-aly. It is on only in the prod
  // environment, which the deploy builds with (cargo site --publish).
  "flags": ["ANALYTICS"],
  "environments": {
    "prod": "env/prod.json"
  },
  "fmt": {
    "exclude": [
      "articles",
      "tools-articles",
      "src/content",
      "public/articles",
      "public/assets/images/articles",
      "git-hooks",
      ".claude",
      "target"
    ]
  },
  "lint": {
    "exclude": ["tools-articles", "git-hooks", "target"]
  },
  "maxFileSizeIgnore": ["articles", "public/assets/images", "tools-articles"]
}
